{
  "name": "sim-haf-playwright",
  "version": "1.0.0",
  "description": "SIM HAF requirement-based UAT automation (Playwright + TypeScript)",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:auth": "playwright test tests/auth",
    "test:pengaturan": "playwright test tests/pengaturan",
    "test:list": "playwright test --list",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "baseline:build": "node scripts/build-baseline.mjs",
    "baseline:verify": "node scripts/verify-baseline.mjs",
    "batches:validate": "node scripts/validate-batches.mjs",
    "summary": "node scripts/generate-summary.mjs",
    "merge:reports": "node scripts/merge-reports.mjs",
    "report:selftest": "node scripts/reporting-selftest.mjs"
  },
  "keywords": [
    "playwright",
    "uat",
    "requirement-based"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
