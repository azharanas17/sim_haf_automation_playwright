# ---------------------------------------------------------------------------
# SIM HAF Playwright - environment template
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Never commit real credentials or environment-specific secrets.
# ---------------------------------------------------------------------------

# Base URL of the UAT application under test (no trailing slash).
# Staging SIM HAF:
BASE_URL=https://staging.kas.alkhidmah.or.id

# Optional path to the login screen, relative to BASE_URL.
# Defaults to /login if not set. This is an UNRESOLVED locator detail:
# it must be confirmed against the UAT environment, not application source code.
LOGIN_PATH=/login

# Optional path to a protected page used to verify unauthenticated redirect.
# Defaults to /dashboard if not set.
PROTECTED_PATH=/dashboard

# Optional module paths for journey J-S2 (Kelola Struktur Organisasi).
# Grounded in routes/web.php; defaults shown below.
BIDANG_PATH=/pengaturan/bidang
KHIDMAH_PATH=/pengaturan/khidmah

# Execution controls
RETRIES=0
WORKERS=
HEADLESS=true

# ---------------------------------------------------------------------------
# Test identities
# The approved workbook (SIM_HAF_Requirement_Based_Test_Scenarios_v4.xlsx,
# journey J-S1) identifies the Superadmin test account as:
#   admin@simhaf.test  (2FA enabled)
# The password / TOTP secret are NOT stored in this repository. Supply them
# via the environment variables below when running against a real UAT env.
#
# OTP is NOT mandatory for every account. `UAT_OTP_REQUIRED_<IDENTITY>` states
# whether an identity needs a 2FA/OTP step after the credentials step:
#   - unset/empty -> derives from whether that identity's TOTP secret is set
#   - false       -> log in with email + password only (no OTP)
#   - true        -> OTP required; a TOTP secret must also be supplied
# ---------------------------------------------------------------------------
UAT_EMAIL_SUPERADMIN=
UAT_PASSWORD_SUPERADMIN=
# Set to false for the staging UAT account that does not require OTP.
UAT_OTP_REQUIRED_SUPERADMIN=
# Only needed when UAT_OTP_REQUIRED_SUPERADMIN=true.
UAT_TOTP_SECRET_SUPERADMIN=

# Test identity for a deliberately inactive account (TC-REQ-010).
# This account must be provisioned in UAT; it is not defined by the workbook.
UAT_EMAIL_INACTIVE=
UAT_PASSWORD_INACTIVE=
