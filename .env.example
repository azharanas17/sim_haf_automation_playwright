# ---------------------------------------------------------------------------
# SIM HAF Playwright - environment template
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Never commit real credentials or environment-specific secrets.
# ---------------------------------------------------------------------------

# Base URL of the UAT application under test (no trailing slash).
# Staging SIM HAF:
BASE_URL=https://staging.kas.alkhidmah.or.id

# Optional path to the login screen, relative to BASE_URL.
# Defaults to /login if not set. This is an UNRESOLVED locator detail:
# it must be confirmed against the UAT environment, not application source code.
LOGIN_PATH=/login

# Optional path to a protected page used to verify unauthenticated redirect.
# Defaults to /dashboard if not set.
PROTECTED_PATH=/dashboard

# Optional module paths for journey J-S2 (Kelola Struktur Organisasi).
# Grounded in routes/web.php; defaults shown below.
BIDANG_PATH=/pengaturan/bidang
KHIDMAH_PATH=/pengaturan/khidmah

# Execution controls
RETRIES=0
WORKERS=
HEADLESS=true

# ---------------------------------------------------------------------------
# Test identities
# The approved workbook (SIM_HAF_Requirement_Based_Test_Scenarios_v4.xlsx,
# journey J-S1) identifies the Superadmin test account as:
#   admin@simhaf.test  (2FA enabled)
# The password / TOTP secret are NOT stored in this repository. Supply them
# via the environment variables below when running against a real UAT env.
#
# OTP is NOT mandatory for every account. `UAT_OTP_REQUIRED_<IDENTITY>` states
# whether an identity needs a 2FA/OTP step after the credentials step:
#   - unset/empty -> derives from whether that identity's TOTP secret is set
#   - false       -> log in with email + password only (no OTP)
#   - true        -> OTP required; a TOTP secret must also be supplied
# ---------------------------------------------------------------------------
UAT_EMAIL_SUPERADMIN=
UAT_PASSWORD_SUPERADMIN=
# Set to false for the staging UAT account that does not require OTP.
UAT_OTP_REQUIRED_SUPERADMIN=
# Only needed when UAT_OTP_REQUIRED_SUPERADMIN=true.
UAT_TOTP_SECRET_SUPERADMIN=

# Test identity for a deliberately inactive account (TC-REQ-010).
# This account must be provisioned in UAT; it is not defined by the workbook.
# NOTE: this is DISTINCT from UAT_EMAIL_PJ_SEKSI_NONAKTIF below - never reuse.
UAT_EMAIL_INACTIVE=
UAT_PASSWORD_INACTIVE=

# ---------------------------------------------------------------------------
# Role identities (see test-data/users.ts `roleIdentity` exports).
# For each identity, supply UAT_EMAIL_<IDENTITY> / UAT_PASSWORD_<IDENTITY>.
# An identity left unset only skips the scenarios that require that role.
#
# OTP is OPTIONAL per identity and never forced. Leave the *_OTP_REQUIRED /
# *_TOTP_SECRET pair unset (or set UAT_OTP_REQUIRED_<IDENTITY>=false) for
# accounts that log in with email + password only. When a TOTP secret is set,
# otpRequired derives to true unless explicitly overridden.
# ---------------------------------------------------------------------------

# Ketua Umum
UAT_EMAIL_KETUA_UMUM=
UAT_PASSWORD_KETUA_UMUM=
UAT_OTP_REQUIRED_KETUA_UMUM=
UAT_TOTP_SECRET_KETUA_UMUM=

# Sekretaris Umum
UAT_EMAIL_SEKRETARIS_UMUM=
UAT_PASSWORD_SEKRETARIS_UMUM=
UAT_OTP_REQUIRED_SEKRETARIS_UMUM=
UAT_TOTP_SECRET_SEKRETARIS_UMUM=

# Bendahara Umum
UAT_EMAIL_BENDAHARA_UMUM=
UAT_PASSWORD_BENDAHARA_UMUM=
UAT_OTP_REQUIRED_BENDAHARA_UMUM=
UAT_TOTP_SECRET_BENDAHARA_UMUM=

# Ketua Bidang
UAT_EMAIL_KETUA_BIDANG=
UAT_PASSWORD_KETUA_BIDANG=
UAT_OTP_REQUIRED_KETUA_BIDANG=
UAT_TOTP_SECRET_KETUA_BIDANG=

# Sekretaris Bidang
UAT_EMAIL_SEKRETARIS_BIDANG=
UAT_PASSWORD_SEKRETARIS_BIDANG=
UAT_OTP_REQUIRED_SEKRETARIS_BIDANG=
UAT_TOTP_SECRET_SEKRETARIS_BIDANG=

# PJ Seksi
UAT_EMAIL_PJ_SEKSI=
UAT_PASSWORD_PJ_SEKSI=
UAT_OTP_REQUIRED_PJ_SEKSI=
UAT_TOTP_SECRET_PJ_SEKSI=

# PJ Seksi (Nonaktif) - DISTINCT from UAT_EMAIL_INACTIVE above.
UAT_EMAIL_PJ_SEKSI_NONAKTIF=
UAT_PASSWORD_PJ_SEKSI_NONAKTIF=
UAT_OTP_REQUIRED_PJ_SEKSI_NONAKTIF=
UAT_TOTP_SECRET_PJ_SEKSI_NONAKTIF=

# Panitia Lapangan
UAT_EMAIL_PANITIA_LAPANGAN=
UAT_PASSWORD_PANITIA_LAPANGAN=
UAT_OTP_REQUIRED_PANITIA_LAPANGAN=
UAT_TOTP_SECRET_PANITIA_LAPANGAN=

# Invalid credentials for TC-REQ-006 need NO configuration: the suite ships a
# deliberately-wrong default (an unregistered @simhaf.test email and a wrong
# password). Override only if you want to pin a specific pair.
# UAT_EMAIL_INVALID=
# UAT_PASSWORD_INVALID=
